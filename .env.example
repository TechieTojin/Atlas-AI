# Only required credential: Tavily web search (free tier: https://app.tavily.com)
# The default LLM is local Ollama — no LLM API key needed.
TAVILY_API_KEY=

# LLM settings (defaults shown)
ATLAS_LLM_PROVIDER=ollama
ATLAS_MODEL=qwen3:4b
ATLAS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Research settings (defaults shown)
ATLAS_MAX_RESEARCH_ITERATIONS=3
ATLAS_SEARCH_RESULTS_PER_QUERY=5
ATLAS_MAX_QUERIES_PER_ITERATION=5

# Critic sufficiency: SYNTHESIZE requires score >= this (0-10)
ATLAS_SUFFICIENCY_THRESHOLD=7

# Evidence items sent through the local LLM (all evidence stays collected)
ATLAS_MAX_EVIDENCE_FOR_CRITIC=12
ATLAS_MAX_EVIDENCE_FOR_SYNTHESIS=12

# Approximate length of the final report
ATLAS_REPORT_TARGET_WORDS=1000

# Qwen3 thinking mode for structured planner/critic calls (more reliable
# scores/decisions, slower). Thinking text is never shown or logged.
ATLAS_OLLAMA_STRUCTURED_REASONING=true

# --- V2: persistence, documents (RAG), research memory ---

# Where Atlas stores its SQLite database and uploaded documents
ATLAS_DATA_DIR=data

# Hours that web evidence stays reusable from research memory (0 disables)
ATLAS_MEMORY_TTL_HOURS=72

# Upload limit for documents (PDF/TXT/MD)
ATLAS_MAX_UPLOAD_MB=25

# Local Ollama embedding model for document retrieval (ollama pull nomic-embed-text)
ATLAS_EMBEDDING_MODEL=nomic-embed-text

# Document chunks retrieved per research query
ATLAS_RAG_CHUNKS_PER_QUERY=4

# --- V3 ---

# Full-page web research: pages fetched per query (0 disables; FAST uses 1)
ATLAS_PAGE_FETCH_PER_QUERY=2
ATLAS_PAGE_TIMEOUT_SECONDS=15
ATLAS_PAGE_MAX_BYTES=1500000
ATLAS_PAGE_CHUNKS_PER_PAGE=2

# Semantic research memory: cosine similarity needed to reuse evidence
ATLAS_MEMORY_SEMANTIC_THRESHOLD=0.83

# Knowledge graph bounds
ATLAS_KG_MAX_NODES=40
ATLAS_KG_MAX_EDGES=60

# Optional TTF font for PDF export (auto-detects Arial/DejaVu when empty)
ATLAS_PDF_FONT=

# Hard ceiling per LLM request (seconds)
ATLAS_LLM_TIMEOUT_SECONDS=900

# Ollama model parameters (one context size for all stages avoids model
# reloads; keep-alive keeps the model loaded between stages/runs)
ATLAS_LLM_NUM_CTX=8192
ATLAS_LLM_KEEP_ALIVE=30m

# Concurrent search/page-fetch workers during retrieval
ATLAS_RETRIEVAL_WORKERS=4

# Optional whole-run time budget for DEEP mode in seconds (0 = none).
# FAST always uses its own fixed budget (see src/modes.py).
ATLAS_DEEP_RUN_BUDGET_SECONDS=0

# API port for python -m src.api.server
ATLAS_API_PORT=8000
